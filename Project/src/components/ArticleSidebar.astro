---
import type { ArticleSummary } from '../lib/articles';

interface Props {
  topicTitle: string;
  topicSlug: string;
  articles: ArticleSummary[];
  currentSlug: string;
}

const { topicTitle, topicSlug, articles, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="article-sidebar" data-article-sidebar data-topic={topicSlug}>
  <div class="sidebar-header">
    <a class="topic-link" href={`${base}articles/${topicSlug}/`}>{topicTitle}</a>
    <button
      class="icon-toggle sidebar-toggle is-open"
      type="button"
      aria-expanded="true"
      aria-controls="article-sidebar-panel"
      aria-label="Close article list"
      data-sidebar-toggle
    >
      <span class="icon-toggle-bar" aria-hidden="true"></span>
      <span class="icon-toggle-bar" aria-hidden="true"></span>
      <span class="icon-toggle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="article-nav" id="article-sidebar-panel" aria-label="Articles in this topic" data-sidebar-panel>
    <ul>
      {
        articles.map((item) => (
          <li>
            <a
              href={`${base}articles/${item.topicSlug}/${item.slug}/`}
              class:list={[{ active: item.slug === currentSlug }]}
              aria-current={item.slug === currentSlug ? 'page' : undefined}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script>
  const mq = window.matchMedia('(max-width: 819px)');
  const openKey = 'article-sidebar-open';

  const getParts = () => {
    const root = document.querySelector('[data-article-sidebar]');
    const shell = document.querySelector('[data-article-shell]');
    const toggle = root?.querySelector('[data-sidebar-toggle]');
    const panel = root?.querySelector('[data-sidebar-panel]');
    if (
      !(root instanceof HTMLElement) ||
      !(shell instanceof HTMLElement) ||
      !(toggle instanceof HTMLButtonElement) ||
      !(panel instanceof HTMLElement)
    ) {
      return null;
    }
    return { root, shell, toggle, panel, scrollKey: `article-sidebar-scroll:${root.dataset.topic}` };
  };

  const isOpen = () => !getParts()?.root.classList.contains('is-collapsed');

  const setOpen = (open: boolean, remember = true) => {
    const parts = getParts();
    if (!parts) return;
    const { root, shell, toggle } = parts;
    root.classList.toggle('is-collapsed', !open);
    shell.classList.toggle('sidebar-collapsed', !open);
    shell.classList.toggle('sidebar-open', open);
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close article list' : 'Open article list');
    document.body.classList.toggle('sidebar-drawer-open', open && mq.matches);
    if (remember && !mq.matches) sessionStorage.setItem(openKey, String(open));
  };

  // Runs on the incoming page before it is shown, so the sidebar never visibly changes state.
  // Desktop keeps the last open/closed choice; the mobile drawer always starts closed.
  const applyState = () => {
    const parts = getParts();
    if (!parts) return;
    setOpen(!mq.matches && sessionStorage.getItem(openKey) !== 'false', false);
    const savedScroll = sessionStorage.getItem(parts.scrollKey);
    if (savedScroll !== null) parts.panel.scrollTop = Number(savedScroll);
  };

  const saveScroll = () => {
    const parts = getParts();
    if (parts) sessionStorage.setItem(parts.scrollKey, String(parts.panel.scrollTop));
  };

  // The outgoing sidebar stays on screen until the swap, so highlight the destination now;
  // otherwise the old and new highlights show together and the old one snaps away.
  const highlightDestination = (to: URL) => {
    const parts = getParts();
    if (!parts) return;
    parts.root.dataset.navigating = 'true';
    parts.panel.querySelectorAll('a').forEach((link) => {
      const isTarget = new URL(link.href).pathname === to.pathname;
      link.classList.toggle('active', isTarget);
      if (isTarget) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('[data-sidebar-toggle]')) setOpen(!isOpen());
    else if (target?.closest('[data-sidebar-backdrop]')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && getParts()) setOpen(false);
  });

  mq.addEventListener('change', applyState);

  applyState();
  document.addEventListener('astro:before-preparation', (event) => {
    saveScroll();
    highlightDestination((event as Event & { to: URL }).to);
  });
  document.addEventListener('astro:after-swap', applyState);
  window.addEventListener('pagehide', saveScroll);
</script>

<style>
  .article-sidebar {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    height: 100%;
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    transition:
      background-color var(--motion),
      border-color var(--motion);
  }

  .sidebar-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.1rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .topic-link {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.25;
    padding-top: 0.35rem;
  }

  .topic-link:hover {
    color: var(--color-accent);
  }

  .sidebar-toggle {
    flex-shrink: 0;
  }

  .article-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem 0.75rem 1.5rem;
  }

  .article-sidebar.is-collapsed .topic-link,
  .article-sidebar.is-collapsed .article-nav {
    display: none;
  }

  .article-sidebar.is-collapsed .sidebar-header {
    justify-content: center;
    padding: 1rem 0.5rem;
    border-bottom: 0;
  }

  .article-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-nav li + li {
    margin-top: 0.15rem;
  }

  .article-nav a {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 0.5rem;
    color: var(--color-muted);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    transition:
      color var(--motion),
      background-color var(--motion);
  }

  /* Switch the highlight instantly while navigating so the outgoing snapshot matches the new page. */
  .article-sidebar[data-navigating] .article-nav a {
    transition: none;
  }

  .article-nav a:hover,
  .article-nav a.active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .article-nav a.active {
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  @media (max-width: 819px) {
    .article-sidebar,
    .article-sidebar.is-collapsed {
      height: 100%;
      max-height: 100%;
      border: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-soft);
      overflow: hidden;
    }

    /* Panel visibility is handled by the parent; always show list content on mobile. */
    .article-sidebar.is-collapsed .topic-link,
    .article-sidebar.is-collapsed .article-nav {
      display: block;
    }

    .article-sidebar.is-collapsed .sidebar-header {
      justify-content: space-between;
      padding: 1.1rem 1rem;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>


