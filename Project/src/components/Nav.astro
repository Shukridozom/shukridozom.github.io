---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: 'Home', match: 'home' },
  { href: `${base}articles/`, label: 'Articles', match: 'articles' },
  { href: `${base}projects/`, label: 'Projects', match: 'projects' },
  { href: `${base}contact/`, label: 'Contact Me', match: 'contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base}>{site.name}</a>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-base={base}>
      {
        links.map((link) => (
          <a href={link.href} class="nav-link" data-nav-match={link.match}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button
        class="icon-toggle nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
        data-nav-toggle
      >
        <span class="icon-toggle-bar" aria-hidden="true"></span>
        <span class="icon-toggle-bar" aria-hidden="true"></span>
        <span class="icon-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const isActive = (match: string, pathname: string, base: string) => {
    const normalized = pathname.endsWith('/') || pathname.endsWith('.html')
      ? pathname
      : `${pathname}/`;

    if (match === 'home') {
      return (
        pathname === base ||
        pathname === `${base}index.html` ||
        normalized === base ||
        pathname === '/' ||
        pathname === ''
      );
    }

    return pathname.includes(`/${match}`) || pathname.includes(`${base}${match}`);
  };

  const syncActiveLinks = () => {
    const nav = document.querySelector('#site-nav');
    if (!(nav instanceof HTMLElement)) return;

    const base = nav.dataset.base || '/';
    const pathname = window.location.pathname;

    nav.querySelectorAll<HTMLAnchorElement>('a.nav-link').forEach((link) => {
      const match = link.dataset.navMatch || '';
      const active = isActive(match, pathname, base);
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  const bindNav = () => {
    const header = document.querySelector('.site-header');
    const toggle = document.querySelector('[data-nav-toggle]');
    const nav = document.querySelector('#site-nav');

    syncActiveLinks();

    if (!header || !(toggle instanceof HTMLButtonElement) || !nav) return;
    if (toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-open'));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  };

  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--motion),
      border-color var(--motion);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
    position: relative;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    transition: color var(--motion);
  }

  .brand:hover {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 0;
    right: 0;
    padding: 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--motion),
      transform var(--motion),
      visibility var(--motion),
      background-color var(--motion),
      border-color var(--motion);
  }

  .site-header.is-open .site-nav {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  .nav-link {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.5rem;
    transition:
      color var(--motion),
      background-color var(--motion);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .nav-link.active {
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  @media (min-width: 720px) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      margin-left: auto;
      flex-direction: row;
      align-items: center;
      gap: 0.35rem 1.1rem;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      visibility: visible;
      transition: none;
    }

    .nav-link {
      padding: 0;
      font-size: 0.95rem;
      border-radius: 0;
    }

    .nav-link:hover,
    .nav-link.active {
      background: transparent;
    }
  }
</style>
