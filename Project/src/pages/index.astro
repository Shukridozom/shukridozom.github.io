---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';

const photoSrc = `${import.meta.env.BASE_URL}${site.photo}`;
---

<BaseLayout title="Home" description={site.about}>
  <Nav slot="nav" />

  <section class="hero">
    <img class="avatar" src={photoSrc} alt={`Profile photo of ${site.name}`} width="160" height="160" />
    <div class="hero-copy">
      <p class="eyebrow">{site.name}</p>
      <h1 class="job-title">{site.jobTitle}</h1>
      <p class="intro">{site.about}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding-block: 1.5rem 2rem;
  }

  @media (min-width: 720px) {
    .hero {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
      min-height: calc(100vh - var(--nav-height) - 7rem);
    }
  }

  .avatar {
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-surface);
    box-shadow: 0 12px 30px rgb(28 25 21 / 12%);
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .job-title {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .intro {
    margin: 0;
    max-width: 36rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
</style>
