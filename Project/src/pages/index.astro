---
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';

const photoSrc = `${import.meta.env.BASE_URL}${site.photo}`;
const aboutHtml = marked.parse(site.about, { async: false }) as string;
const description = site.about.split('\n\n')[0]?.replace(/\*\*/g, '') ?? site.about;
---

<BaseLayout title="Home" description={description}>
  <Nav slot="nav" />

  <section class="hero">
    <img class="avatar" src={photoSrc} alt={`Profile photo of ${site.name}`} width="256" height="256" />
    <div class="hero-copy">
      <p class="eyebrow">{site.name}</p>
      <h1 class="job-title">{site.jobTitle}</h1>
    </div>
  </section>

  <section class="about prose" set:html={aboutHtml} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding-block: 1.5rem 2rem;
  }

  @media (min-width: 720px) {
    .hero {
      grid-template-columns: auto 1fr;
      gap: 2.5rem;
    }
  }

  .avatar {
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-surface);
    box-shadow: 0 12px 30px rgb(28 25 21 / 12%);
  }

  @media (min-width: 720px) {
    .avatar {
      width: 16rem;
      height: 16rem;
    }
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .job-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-accent);
  }

  .about {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .about :global(p:first-child) {
    margin-top: 0;
  }

  .about :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .about :global(ul) {
    margin: 0 0 1rem;
  }

  .about :global(li + li) {
    margin-top: 0.25rem;
  }
</style>
