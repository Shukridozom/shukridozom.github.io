---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { getTopics } from '../../lib/articles';

const topics = getTopics();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Articles" description="Articles and notes by topic.">
  <Nav slot="nav" />

  <h1 class="page-title">Articles</h1>
  <p class="page-lead">Browse topics and open a topic to see its articles.</p>

  {
    topics.length === 0 ? (
      <p class="empty-state">No articles yet. Add topic folders under <code>Articles</code>.</p>
    ) : (
      <div class="topic-grid">
        {topics.map((topic) => (
          <a class="topic-card" href={`${base}articles/${topic.slug}/`}>
            <h2 class:list={['topic-title', { 'topic-title--solo': !topic.summary }]}>
              {topic.title}
            </h2>
            {topic.summary && <p class="topic-summary">{topic.summary}</p>}
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .topic-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .topic-card {
    display: block;
    padding: 1.35rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .topic-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
  }

  .topic-title {
    margin: 0 0 0.55rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .topic-title--solo {
    margin-bottom: 0;
  }

  .topic-summary {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.98rem;
  }
</style>
