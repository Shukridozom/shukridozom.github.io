---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import { getTopic, getTopics } from '../../../lib/articles';

export function getStaticPaths() {
  return getTopics().map((topic) => ({
    params: { topic: topic.slug },
  }));
}

const topic = getTopic(Astro.params.topic!);

if (!topic) {
  throw new Error(`Topic not found: ${Astro.params.topic}`);
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={topic.title} description={topic.summary ?? `Articles in ${topic.title}`}>
  <Nav slot="nav" />

  <p class="crumb">
    <a href={`${base}articles/`}>Articles</a>
    <span aria-hidden="true"> / </span>
    <span>{topic.title}</span>
  </p>

  <h1 class="page-title">{topic.title}</h1>
  {
    topic.summary && <p class="page-lead">{topic.summary}</p>
  }

  {
    topic.articles.length === 0 ? (
      <p class="empty-state">No articles in this topic yet.</p>
    ) : (
      <ul class="article-list">
        {topic.articles.map((article) => (
          <li>
            <a href={`${base}articles/${article.topicSlug}/${article.slug}/`}>{article.title}</a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .crumb {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 42rem;
  }

  .article-list li + li {
    margin-top: 0.55rem;
  }

  .article-list a {
    font-weight: 600;
    text-decoration: none;
  }

  .article-list a:hover {
    text-decoration: underline;
  }
</style>
