---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import ArticleSidebar from '../../../components/ArticleSidebar.astro';
import { getAllArticles, getArticle, getTopic } from '../../../lib/articles';

export function getStaticPaths() {
  return getAllArticles().map((article) => ({
    params: {
      topic: article.topicSlug,
      article: article.slug,
    },
  }));
}

const { topic, article: articleParam } = Astro.params;
const article = getArticle(topic!, articleParam!);
const topicData = getTopic(topic!);

if (!article || !topicData) {
  throw new Error(`Article not found: ${topic}/${articleParam}`);
}

---

<BaseLayout
  title={article.title}
  description={`${article.title} — ${article.topicTitle}`}
  fullBleed
  fadeMain={false}
>
  <Nav slot="nav" />

  <div class="article-shell" data-article-shell>
    <button
      class="icon-toggle mobile-sidebar-open"
      type="button"
      aria-label="Open article list"
      data-mobile-sidebar-open
    >
      <span class="icon-toggle-bar" aria-hidden="true"></span>
      <span class="icon-toggle-bar" aria-hidden="true"></span>
      <span class="icon-toggle-bar" aria-hidden="true"></span>
    </button>

    <div class="sidebar-backdrop" data-sidebar-backdrop></div>

    <div class="sidebar-column">
      <ArticleSidebar
        topicTitle={topicData.title}
        topicSlug={topicData.slug}
        articles={topicData.articles}
        currentSlug={article.slug}
      />
    </div>

    <div class="article-content" transition:animate="fade">
      <article class="prose article-body" set:html={article.html} />
    </div>
  </div>
</BaseLayout>

<script>
  const bindMobileOpen = () => {
    const openBtn = document.querySelector('[data-mobile-sidebar-open]');
    const sidebarToggle = document.querySelector('[data-sidebar-toggle]');

    if (!(openBtn instanceof HTMLButtonElement) || !(sidebarToggle instanceof HTMLButtonElement)) return;
    if (openBtn.dataset.bound === 'true') return;
    openBtn.dataset.bound = 'true';

    openBtn.addEventListener('click', () => {
      sidebarToggle.click();
    });
  };

  bindMobileOpen();
  document.addEventListener('astro:page-load', bindMobileOpen);
</script>

<style>
  .article-shell {
    --sidebar-width: 18.5rem;
    --sidebar-collapsed-width: 3.5rem;
    --content-gap: clamp(1rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: calc(100vh - var(--nav-height));
  }

  .mobile-sidebar-open {
    display: none;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* Sidebar and article share one full-width cell, so the article's % padding
     resolves against the same width as the header's .container. */
  .sidebar-column {
    grid-area: 1 / 1;
    justify-self: start;
    position: sticky;
    top: var(--nav-height);
    width: var(--sidebar-width);
    height: calc(100vh - var(--nav-height));
    align-self: start;
    min-width: 0;
    z-index: 5;
    transition: width var(--motion);
  }

  .article-shell.sidebar-collapsed .sidebar-column {
    width: var(--sidebar-collapsed-width);
  }

  .article-content {
    grid-area: 1 / 1;
    min-width: 0;
    padding: 2rem var(--content-gap) 3.5rem;
    padding-left: max(
      calc((100% - var(--max-width)) / 2),
      1rem,
      calc(var(--sidebar-width) + var(--content-gap))
    );
    transition: padding-left var(--motion);
  }

  .article-shell.sidebar-collapsed .article-content {
    padding-left: max(
      calc((100% - var(--max-width)) / 2),
      1rem,
      calc(var(--sidebar-collapsed-width) + 1rem)
    );
  }

  .article-body {
    max-width: 46rem;
  }

  .article-body :global(> :first-child) {
    margin-top: 0;
  }

  @media (max-width: 819px) {
    .article-shell,
    .article-shell.sidebar-collapsed {
      grid-template-columns: 1fr;
      min-height: calc(100vh - var(--nav-height));
    }

    .sidebar-column,
    .article-content {
      grid-area: auto;
    }

    .mobile-sidebar-open {
      display: inline-flex;
      position: sticky;
      top: calc(var(--nav-height) + 0.65rem);
      z-index: 4;
      margin: 0.85rem 1rem 0;
    }

    .article-shell.sidebar-open .mobile-sidebar-open {
      visibility: hidden;
      pointer-events: none;
    }

    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: var(--nav-height) 0 0;
      background: var(--color-overlay);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--motion);
      z-index: 6;
    }

    .article-shell.sidebar-open .sidebar-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    /* Match main navbar mobile menu: full-width card under the header. */
    .sidebar-column,
    .article-shell.sidebar-collapsed .sidebar-column {
      position: fixed;
      top: calc(var(--nav-height) + 0.65rem);
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      width: auto;
      height: auto;
      /* Desktop's `start` alignment would size the fixed drawer to its content instead of the insets. */
      align-self: stretch;
      justify-self: stretch;
      z-index: 7;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-6px);
      transition:
        opacity var(--motion),
        transform var(--motion),
        visibility var(--motion);
      box-shadow: none;
    }

    .article-shell.sidebar-open .sidebar-column {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .article-content,
    .article-shell.sidebar-collapsed .article-content {
      padding: 0.75rem 1rem 3rem;
      transition: none;
    }
  }
</style>

